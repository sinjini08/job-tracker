{
  "manifest_version": 3,
  "name": "Job Application Tracker",
  "version": "1.0.0",
  "description": "Keep track of your job applications on the go. File the posting you are looking at, and mark it applied when you send it, without retyping anything.",
  "action": {
    "default_title": "Save this posting",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "externally_connectable": {
    "matches": ["https://myjobtracker.co/*"]
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
