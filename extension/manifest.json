{
  "manifest_version": 3,
  "name": "Job Application Tracker",
  "version": "1.0.2",
  "description": "See a job. Save it. Track it. One click captures the posting, so you spend less time tracking and more time applying.",
  "action": {
    "default_title": "Save this posting",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "externally_connectable": {
    "matches": ["https://myjobtracker.co/*"]
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
