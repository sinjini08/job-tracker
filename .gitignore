# Every dotenv variant, because .env.production and .env.development were not
# covered and would have been committed the first time either was created.
# .env.example is already tracked and is placeholders only; the negation keeps
# it that way.
.env*
!.env.example
.vercel
.DS_Store

# Local-only harnesses: a page under app/ is a real route, so anything left
# here would ship. Kept on disk, out of the build.
app/dev-preview/
.claude/
dist/
public/_shot/

# Instructions for AI assistants working in this repo. Kept on disk, out of
# the history: they are notes to a tool, not part of the project, and nothing
# in them would mean anything to someone reading the code.
AGENTS.md
CLAUDE.md
