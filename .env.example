# Supabase → Project Settings → API Keys (and the Project URL)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_…). Safe to expose.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). Server-only; never share or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Clerk → Configure → API keys. Sign-in provider.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Use the app's own sign-in pages instead of Clerk's hosted portal
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional. Anthropic → Console → API keys. Lets the browser extension ask a
# model which lines of a posting are the requirements; without it the
# extension's own matcher fills that field and everything else still works.
ANTHROPIC_API_KEY=
# Optional. Model reads per student per day for the above (default 20).
EXT_READS_PER_DAY=
