# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "service_role" secret key (NOT the anon/publishable one). Server-only; never share it.
SUPABASE_SERVICE_ROLE_KEY=

# Access codes. EDIT_CODE is yours; VIEW_CODE is what you give other people.
EDIT_CODE=
VIEW_CODE=

# Random string, 32+ characters, used to sign login cookies.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=
